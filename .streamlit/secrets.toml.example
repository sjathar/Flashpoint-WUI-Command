# Flashpoint: WUI Command — Streamlit secrets
# Copy to .streamlit/secrets.toml and fill in your Supabase project values.

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "YOUR_SUPABASE_ANON_KEY"

# Public URL used to build the player QR code.
# On conference Wi‑Fi use your laptop's LAN IP (not localhost), e.g.:
# APP_BASE_URL = "http://192.168.1.10:8501"
APP_BASE_URL = "http://localhost:8501"
