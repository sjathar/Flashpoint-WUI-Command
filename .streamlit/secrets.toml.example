# WUI Interactive — Streamlit secrets
# Copy to .streamlit/secrets.toml (local) or Streamlit Cloud → Settings → Secrets.

# Local SQLite (shared among all users on one Streamlit instance).
# Keep true for Cloud phone testing unless WUI tables are in Supabase.
USE_LOCAL_DB = true

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "YOUR_SUPABASE_ANON_KEY"

# Public URL for the player QR code.
# Local: http://localhost:8501
# Cloud: https://YOUR-APP.streamlit.app  (also auto-detected from the Host header)
APP_BASE_URL = "http://localhost:8501"

# Optional readable join link. When set, the QR code uses this instead of TinyURL.
# APP_SHORT_URL = "https://tinyurl.com/your-code"
